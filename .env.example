# Leave empty (or set localhost) for local mode → http://127.0.0.1:$STEVIE_LISTEN_PORT
# Set a real hostname for TLS (internal CA or mounted certs).
STEVIE_DOMAIN=
STEVIE_LISTEN_PORT=28413
STEVIE_HTTPS_PORT=8443
# Used when STEVIE_DOMAIN is set: internal | files | off (off = cleartext / external proxy)
TLS_MODE=internal
# TLS_MODE=files uses deploy/certs/tls.crt and deploy/certs/tls.key by default
# TLS_CERTS_DIR=./certs

STEVIE_ADMIN_USER=admin
STEVIE_ADMIN_PASSWORD=changeme
# Leave unset in local mode (auto false). Set true behind HTTPS.
# STEVIE_SECURE_COOKIES=true

POSTGRES_PASSWORD=stevie
TMDB_API_KEY=
# Conservative default under TMDB's ~40 req/s CDN ceiling
TMDB_RPS=20

# Host path mounted read-only at /media/library (legacy local-library APIs; UI uses Xtream VOD).
# Compose requires a real directory — use any empty folder if unused.
MEDIA_LIBRARY_PATH=/data/stevie/media

# Host path mounted read-only at /live-sources for local M3U / XMLTV files
LIVE_SOURCES_PATH=/data/stevie/live-sources

# Host path for live recordings + VOD downloads (ffmpeg), mounted rw at /recordings
STEVIE_RECORDINGS_PATH=/data/stevie/recordings

# Xtream Codes panel (credentials stay in .env — not editable in the UI)
XTREAM_URL=
XTREAM_USER=
XTREAM_PASSWORD=

# TheSportsDB (free demo key 123; premium unlocks livescores + higher limits)
THESPORTSDB_API_KEY=123
THESPORTSDB_COUNTRIES=Canada,United_States

# streamed.pk sports API + embed.st unlock origins (change if domains move)
STEVIE_STREAMED_BASE_URL=https://streamed.pk
STEVIE_STREAMED_EMBED_URL=https://embed.st
# Node unlock+HLS relay — compose service name (shared Podman pod often uses 127.0.0.1:8091)
STEVIE_STREAMED_RELAY_URL=http://streamed:8091
