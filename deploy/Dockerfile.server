FROM docker.io/library/golang:1.24-bookworm AS build
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY apps/server/go.mod apps/server/go.sum ./
RUN go mod download
COPY apps/server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/stevie ./cmd/stevie

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates ffmpeg mediainfo tzdata \
	&& rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/stevie /app/stevie
COPY apps/server/assets/team-logos /app/team-logos
ENV STEVIE_HTTP_ADDR=:8080
ENV STEVIE_DATA_DIR=/data
ENV STEVIE_TEAM_LOGOS_DIR=/app/team-logos
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["/app/stevie"]
